{
	"name": "@standalone/server-base",
	"version": "0.1.0",
	"private": true,
	"description": "Shared server logic for Standalone apps: crash-report stacks and symbolication, support-chat helpers. A Swift half may join it at the repo root.",
	"type": "module",
	"exports": {
		".": "./server/dist/index.js"
	},
	"types": "./server/dist/index.d.ts",
	"files": [
		"server/dist"
	],
	"scripts": {
		"build": "tsc -p server/tsconfig.build.json",
		"prepare": "npm run build",
		"test": "vitest run --root server",
		"typecheck": "tsc -p server/tsconfig.json --noEmit",
		"format": "prettier --write server"
	},
	"peerDependencies": {
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"prettier": "^3.9.8",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"swift-demangle-wasm": "^1.0.2"
	}
}
